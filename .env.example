# Supabase Configuration
# When provided, data syncs with your remote Supabase PostgreSQL database.
# If omitted or invalid, the app gracefully falls back to persistent local storage with full demo functionality.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Retention configuration (in days, default is 90 days as required)
NEXT_PUBLIC_CLEANING_RETENTION_DAYS=90
